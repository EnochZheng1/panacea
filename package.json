{
  "name": "panacea",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/client/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:lint": "tsx packages/content/scripts/lint.ts",
    "sim:batch": "tsx packages/playtest/src/cli/batch.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:lint && pnpm test",
    "sim:optimize": "tsx packages/playtest/src/cli/optimize.ts",
    "client:dev": "pnpm --filter @panacea/client dev",
    "client:build": "pnpm --filter @panacea/client build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
